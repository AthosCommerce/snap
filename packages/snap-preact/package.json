{
	"name": "@athoscommerce/snap-preact",
	"version": "1.12.0",
	"description": "Snap Preact",
	"main": "dist/cjs/src/index.js",
	"module": "dist/esm/src/index.js",
	"types": "dist/esm/src/index.d.ts",
	"author": "Athos Commerce",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/AthosCommerce/snap.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf ./dist && tsc",
		"build:prod": "rm -rf ./dist && rm -rf ./components/dist && (tsc & p1=$!; tsc -p tsconfig.cjs.json & p2=$!; wait $p1 && wait $p2)",
		"build:docs": "typedoc --out docs src/index.ts && storybook build -c ./components/.storybook -o ./components/docs",
		"cypress": "cypress open --project components/tests",
		"cypress:headless": "cypress run --component --project components/tests",
		"dev": "tsc --watch",
		"format": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
		"lint": "eslint '{src,components}/**/*.{js,jsx,ts,tsx}'",
		"test": "jest",
		"test:watch": "jest --watch",
		"storybook": "storybook dev -c ./components/.storybook -p 6006"
	},
	"dependencies": {
		"@athoscommerce/snap-client": "1.12.0",
		"@athoscommerce/snap-controller": "1.12.0",
		"@athoscommerce/snap-event-manager": "1.12.0",
		"@athoscommerce/snap-logger": "1.12.0",
		"@athoscommerce/snap-platforms": "1.12.0",
		"@athoscommerce/snap-profiler": "1.12.0",
		"@athoscommerce/snap-store-mobx": "1.12.0",
		"@athoscommerce/snap-toolbox": "1.12.0",
		"@athoscommerce/snap-tracker": "1.12.0",
		"@athoscommerce/snap-url-manager": "1.12.0",
		"@emotion/react": "11.13.0",
		"acorn": "8.16.0",
		"classnames": "^2.3.2",
		"colord": "^2.9.3",
		"deepmerge": "4.3.1",
		"dequal": "2.0.3",
		"intersection-observer": "0.12.2",
		"is-plain-object": "5.1.0",
		"react-ranger": "2.1.0",
		"swiper": "11.0.7"
	},
	"peerDependencies": {
		"mobx": "^6.15.1",
		"mobx-react-lite": "^4.1.1",
		"preact": "^10.28.4"
	},
	"devDependencies": {
		"@cypress/react": "^8.0.2",
		"@storybook/addon-docs": "10.5.4",
		"@storybook/addon-themes": "10.5.4",
		"@storybook/preact-vite": "10.5.4",
		"@types/react": "16.14.28",
		"@types/react-ranger": "2.0.4",
		"@types/scheduler": "0.16.8",
		"babel-loader": "9.1.3",
		"cypress": "^14.2.1",
		"mobx": "6.15.1",
		"mobx-react-lite": "4.1.1",
		"preact": "10.28.4",
		"react": "16.14.0",
		"react-dom": "16.14.0",
		"sass": "^1.101.7",
		"storybook": "10.5.4",
		"ts-loader": "9.5.1",
		"vite": "^7.3.6"
	},
	"sideEffects": false,
	"files": [
		"dist/**/*",
		"webpack",
		"eslint/src"
	],
	"exports": {
		".": {
			"types": "./dist/esm/src/index.d.ts",
			"import": "./dist/esm/src/index.js",
			"require": "./dist/cjs/src/index.js"
		},
		"./components": {
			"types": "./dist/esm/components/src/index.d.ts",
			"import": "./dist/esm/components/src/index.js",
			"require": "./dist/cjs/components/src/index.js"
		},
		"./toolbox": {
			"types": "./dist/esm/toolbox/src/index.d.ts",
			"import": "./dist/esm/toolbox/src/index.js",
			"require": "./dist/cjs/toolbox/src/index.js"
		},
		"./webpack": "./webpack/index.js",
		"./eslintplugin": "./eslint/src/index.cjs"
	},
	"gitHead": "c31d6fae1461ef16d593321c312c94b85dad7d96"
}
