{
	// A/B experiment config for the CI-only ts.Program `paths` loss (see the header of
	// validate-config-typed.test.cjs). This is the SAME configuration the sibling
	// tsconfig.json produces via its two-level `extends` chain, but fully self-contained:
	// no extends to re-resolve on a tsconfig reload. If the extends-based variant degrades
	// on CI while this one stays healthy, the root cause is the extends chain being lost
	// on reload. Keep the paths in sync with tsconfig.test.json (rebased to this folder).
	"compilerOptions": {
		"target": "es2020",
		"module": "es2020",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"lib": ["es2020", "esnext.collection", "dom"],
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"types": ["jest", "node"],
		"jsx": "react-jsx",
		"jsxImportSource": "@emotion/react",
		"paths": {
			"@athoscommerce/snap-preact": ["../../../../../packages/snap-preact/src"],
			"@athoscommerce/snap-preact/components": ["../../../../../packages/snap-preact/components/src"],
			"@athoscommerce/snap-preact/toolbox": ["../../../../../packages/snap-preact/toolbox/src"],
			"@athoscommerce/snap-platforms/common": ["../../../../../packages/snap-platforms/common/src"],
			"@athoscommerce/snap-platforms/bigcommerce": ["../../../../../packages/snap-platforms/bigcommerce/src"],
			"@athoscommerce/snap-platforms/magento2": ["../../../../../packages/snap-platforms/magento2/src"],
			"@athoscommerce/snap-platforms/shopify": ["../../../../../packages/snap-platforms/shopify/src"],
			"@athoscommerce/snap-client": ["../../../../../packages/snap-client/src"],
			"@athoscommerce/snap-controller": ["../../../../../packages/snap-controller/src"],
			"@athoscommerce/snap-event-manager": ["../../../../../packages/snap-event-manager/src"],
			"@athoscommerce/snap-logger": ["../../../../../packages/snap-logger/src"],
			"@athoscommerce/snap-profiler": ["../../../../../packages/snap-profiler/src"],
			"@athoscommerce/snap-store-mobx": ["../../../../../packages/snap-store-mobx/src"],
			"@athoscommerce/snap-toolbox": ["../../../../../packages/snap-toolbox/src"],
			"@athoscommerce/snap-tracker": ["../../../../../packages/snap-tracker/src"],
			"@athoscommerce/snap-url-manager": ["../../../../../packages/snap-url-manager/src"],
			"@athoscommerce/snap-shared": ["../../../../../packages/snap-shared"]
		}
	},
	"include": ["*.ts"]
}
